<h1>Kittens</h1>
<% @kittens.each do |kitten| %>
  <p>
    <%= link_to kitten.name, kitten %>
    (age <%= kitten.age %>)
    <%= link_to "Edit", edit_kitten_path(kitten) %>
    <%= link_to "Delete", kitten, data: { turbo_method: :delete, turbo_confirm: "Sure?" } %>
  </p>
<% end %>
<%= link_to "New Kitten", new_kitten_path %>
